NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dingdongnote?schema=public"

# Auth
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long
JWT_ISSUER=dingdongnote-api
JWT_AUDIENCE=dingdongnote-app
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Registration
REGISTRATION_ENABLED=false

# Logging
LOG_LEVEL=info
